# Copy to .env and fill in. Never commit .env.
# Model string uses Pydantic AI format: <provider>:<model>
#   anthropic:claude-sonnet-5-5   (ANTHROPIC_API_KEY)
#   google:gemini-2.5-flash       (GOOGLE_API_KEY, AI Studio free tier)
LLM_MODEL=anthropic:claude-sonnet-5-5

# Provide only the key for the provider you are using.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Seconds to wait between LLM calls (helps stay inside free-tier rate limits)
LLM_CALL_DELAY_S=0

# Use cached extraction results instead of calling an LLM (demo fallback)
USE_EXTRACTION_CACHE=false
